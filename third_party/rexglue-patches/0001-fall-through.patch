     auto* data = reinterpret_cast<const uint32_t*>(ctx.binary.translate(block.base));
@@ -601,6 +635,51 @@ std::string FunctionNode::emitCpp(const EmitContext& ctx) const {
       blockBase += 4;
       ++data;
     }
+
+    // After the block's last instruction the CPU goes on at block.end() unless that instruction ends
+    // the flow. When the next block of this function starts there, the C++ text does the same. When
+    // nothing of this function does - the function's recorded extent (.pdata length, a [functions]
+    // size, a gap-fill run) ends before its code does - the generated function used to end here,
+    // returning to the caller where the guest goes on into the code that follows (TTT2 project patch
+    // 0001). That code is entered as the function that starts there, without touching LR, as a tail
+    // call would be.
+    if (blockEnd > block.base) {
+      const uint32_t lastWord = load_and_swap<uint32_t>(data - 1);
+      const uint32_t next = blockEnd;
+      const bool adjacent =
+          blockIndex + 1 < allBlocks.size() && allBlocks[blockIndex + 1].base == next;
+      if (!adjacent && CanFallThrough(lastWord)) {
+        // The last Disassemble() call above was for the block's last word.
+        const std::string lastMnemonic = insn.opcode ? std::string(insn.opcode->name) : "?";
+        const FunctionNode* nextFn = ctx.graph.getFunction(next);
+        if (labels.contains(next) && containsAddress(next)) {
+          emit_println(body, "\t// TTT2 fall-through after {}: continues at loc_{:X}", lastMnemonic, next);
+          emit_println(body, "\tgoto loc_{:X};", next);
+        } else if (nextFn && nextFn != this && !nextFn->isImport()) {
+          std::string nextName = nextFn->base() == ctx.entryPoint ? std::string("xstart")
+                                 : !nextFn->name().empty()       ? nextFn->name()
+                                                                 : fmt::format("sub_{:08X}", next);
+          REXCODEGEN_WARN(
+              "Fall-through after {}: function 0x{:08X} runs on past its end at 0x{:08X} into {} "
+              "(0x{:08X}); emitted as a tail call",
+              lastMnemonic, base(), next - 4, nextName, next);
+          ctx.reference(nextName);
+          emit_println(body, "\t// TTT2 fall-through after {}: the code runs on into {} (0x{:08X})",
+                       lastMnemonic, nextName, next);
+          emit_println(body, "\t{}(ctx, base);", nextName);
+          emit_println(body, "\treturn;");
+        } else {
+          REXCODEGEN_WARN(
+              "Fall-through after {}: function 0x{:08X} runs on past its end at 0x{:08X} into "
+              "0x{:08X}, where no function starts; the generated code returns there",
+              lastMnemonic, base(), next - 4, next);
+          emit_println(body,
+                       "\t// TTT2 fall-through after {}: the code runs on into 0x{:08X}, where no "
+                       "function starts (returns here)",
+                       lastMnemonic, next);
+        }
+      }
+    }
   }
 
   // --- Close function body (or SEH try block) ---
